# ProjectPulse Environment Configuration Example
PORT=8000
SECRET_KEY=your_secret_session_key_here

# Google OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Map Tile Provider (carto_voyager, carto_positron, osm)
TILE_PROVIDER=carto_voyager

# Database URL (Optional - defaults to SQLite projectpulse.db)
# DATABASE_URL=

# Gemini API Key
GEMINI_API_KEY=
